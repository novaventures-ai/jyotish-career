{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "pnpm install",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}