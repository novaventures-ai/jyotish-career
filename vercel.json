{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "pnpm install",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}